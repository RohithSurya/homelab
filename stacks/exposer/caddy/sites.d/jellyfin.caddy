# Jellyfin — media-server stack, network_mode: host on :8096.
# Access log (real client IP + negotiated protocol) so remote-streaming problems are
# diagnosable: h3 vs h2, status codes, bytes served, and where a stream cuts out.
jellyfin.rosurya.duckdns.org {
	import security_headers
	import access_log jellyfin
	reverse_proxy 10.0.0.64:8096   # Jellyfin runs on the HP (homelab pipeline)
}
