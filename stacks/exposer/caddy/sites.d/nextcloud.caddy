# Nextcloud — runs on the HP (10.0.0.64, deployed by the homelab pipeline), publishes :8081.
# NOT 8080: zigbee2mqtt (bedroom-agent) is network_mode: host and its frontend
# defaults to :8080, so it claims that port first and Nextcloud fails to bind.
nextcloud.rosurya.duckdns.org {
	import geo_filter
	import security_headers
	import access_log nextcloud   # the fail2ban nextcloud jail reads this (nextcloud.log is on the HP)
	# Nextcloud service-discovery redirects.
	redir /.well-known/carddav /remote.php/dav 301
	redir /.well-known/caldav /remote.php/dav 301
	redir /.well-known/webfinger /index.php/.well-known/webfinger 301
	redir /.well-known/nodeinfo /index.php/.well-known/nodeinfo 301
	reverse_proxy 10.0.0.64:8081
}
