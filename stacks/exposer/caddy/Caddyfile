# Global options + shared snippets only. Every vhost lives in its own file under
# sites.d/ — adding a service must never require editing this file.
#
# TLS: automatic Let's Encrypt. Port 80 is blocked by Comcast, so issuance
# happens over TLS-ALPN-01 on :443 (Caddy falls back to it automatically).

{
	email prsurya1020@gmail.com

	# The WAF (see "WAF" in ../CLAUDE.md). `appsec` runs after `respond`, so the geo filter
	# answers first and refused countries never reach CrowdSec.
	order appsec before reverse_proxy
	crowdsec {
		api_url http://127.0.0.1:8089 # CrowdSec LAPI (loopback, see compose)
		api_key {$CROWDSEC_CADDY_BOUNCER_KEY} # Caddy's own bouncer key; compose derives it
		appsec_url http://127.0.0.1:7422 # CrowdSec AppSec component (loopback)
		# Only the first 1 MiB of a request body is inspected. Without a cap the plugin buffers
		# the WHOLE body in memory first -- a 2 GB Immich video upload, all in RAM.
		appsec_max_body_bytes 1048576
		# CrowdSec down, or no answer within 500 ms (a check normally takes ~4 ms) = the request
		# passes unchecked, instead of every request failing with a 500 (or, with the plugin's
		# 2 s default, every request on every site waiting 2 s while CrowdSec hangs).
		# The geo filter and the firewall bans keep working either way.
		appsec_fail_open
		appsec_timeout 500ms
		# Blocks become Caddy errors, so (waf)'s handle_errors can say what happened.
		enable_caddy_error
	}
}

# Shared hardening headers. Import into every site block.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Country filter. Import into every PUBLIC vhost (CI fails a site file that imports
# security_headers but not this). See "Geo filter" in ../CLAUDE.md for how to debug it.
# LAN, loopback and Tailscale (100.64/10) always pass. Everyone else must geolocate to a
# country in GEO_ALLOW_COUNTRIES (compose, e.g. "US IN"); the database is DB-IP's, kept
# fresh by the image (`docker exec caddy geoip info`). A refused request gets a plain 403
# naming its IP, plus the response header X-Blocked-By: geo — the access log records that
# header, `docker exec caddy geoip blocked` lists them, and CrowdSec ignores them.
# TLS-ALPN-01 (certificate renewal) happens in the TLS handshake, before any of this, so
# Let's Encrypt's validators abroad are never affected.
(geo_filter) {
	@geo_blocked {
		not client_ip private_ranges 100.64.0.0/10
		not maxmind_geolocation {
			db_path /geoip/country.mmdb
			allow_countries {$GEO_ALLOW_COUNTRIES}
		}
	}
	header @geo_blocked X-Blocked-By geo
	respond @geo_blocked "Not available from your location (your IP: {client_ip}). [geo filter]" 403
}

# The WAF: CrowdSec AppSec checks every request (headers, URL, first 1 MiB of the body)
# against its blocking rules -- known-exploit "virtual patches" (one per exploited CVE) and
# probes for .env/.git files. Import into every PUBLIC vhost, after geo_filter (CI checks it).
# A blocked request gets a plain 403 saying so, plus the response header X-Blocked-By: waf,
# which the access log records and `docker exec caddy geoip blocked` lists. Rule hits:
# `docker exec crowdsec cscli metrics show appsec`. Emergency off switch: comment out the
# `appsec` line below and reload Caddy (see "WAF" in ../CLAUDE.md).
(waf) {
	appsec
	handle_errors 403 {
		header X-Blocked-By waf
		respond "Request blocked by the web application firewall (your IP: {client_ip}). [waf]" 403
	}
}

# Rolling JSON access log for a public vhost. Pass the log basename, e.g.
#   import access_log immich
# Caddy is the internet-facing edge, so "client_ip" here is the real client IP —
# which is what the fail2ban filters key their bans on.
(access_log) {
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json {
			time_format iso8601
		}
	}
}

# One file per exposed service. Path is relative to this Caddyfile (/etc/caddy).
import sites.d/*.caddy
