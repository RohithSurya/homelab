# Non-secret prod values (HP).
# The UI login lives on the home name (Caddy on the Jetson, LAN + Tailscale only). NextAuth then
# sets secure cookies, so logging in over http://10.0.0.64:3040 no longer works -- the API
# (Hermes, the relay, scripts) still uses the IP with the project keys.
NEXTAUTH_URL=https://langfuse.home.rosurya.duckdns.org
INIT_USER_EMAIL=rosurya@home.lan
RETENTION_DAYS=90
