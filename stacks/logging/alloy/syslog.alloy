// HP only. Router (OpenWrt logd, `uci show system.@system[0].log_ip`) remote syslog: RFC 3164
// lines over TCP (what the router uses) and UDP, on host port 1514.
loki.source.syslog "router" {
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "tcp"
    syslog_format = "rfc3164"
    labels        = { source = "syslog", host = "router" }
  }
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { source = "syslog", host = "router" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.router.receiver]
}

loki.relabel "syslog" {
  forward_to = []
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "ident"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
}

// Separate writer so the router keeps host="router" (no host external label).
loki.write "router" {
  endpoint {
    url = sys.env("LOKI_URL")
    basic_auth {
      username = "agent"
      password = sys.env("LOKI_PASSWORD")
    }
  }
}
