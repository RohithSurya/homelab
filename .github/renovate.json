{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "description": "Image and action updates arrive as PRs and CI tests them. Minor and patch updates whose checks pass are merged by Renovate itself (automergeSchedule below) and deploy.yml deploys them (it accepts renovate[bot] merges); majors, digest bumps and Jellyfin still wait for the owner's merge.",
  "timezone": "America/New_York",
  "schedule": [
    "after 7am and before 11pm"
  ],
  "prConcurrentLimit": 6,
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    "**/tests/**",
    "infra/runner/**"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose\\.ya?ml$/",
      "/(^|/)compose\\.[a-z]+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Immich release pinned in stacks/immich/env/prod.env",
      "managerFilePatterns": [
        "/^stacks/immich/env/prod\\.env$/"
      ],
      "matchStrings": [
        "IMMICH_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/immich-app/immich-server",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Caddy: the exposer image builds with caddy:<v>-builder and runs on caddy:<v> (stacks/exposer/caddy/image/Dockerfile) -- both FROM lines must move in one PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "caddy"
      ],
      "groupName": "caddy"
    },
    {
      "description": "media-bridge stays on Python 3.12 until a deliberate upgrade (and its tests) moves it",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.12/"
    },
    {
      "description": "LinuxServer tags: <app version>-ls<build>",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/prowlarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/bazarr"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Jellyfin dated builds (12.2.20261005-225228); its DB migrations are one-way, so every bump is a reviewed PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "jellyfin/jellyfin"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d{8})-(?<build>\\d{6})$"
    },
    {
      "description": "Nextcloud can't skip a major (34 -> 35 -> 36): one major per PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nextcloud"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-apache$",
      "separateMultipleMajor": true
    },
    {
      "description": "MariaDB stays on the 10.11 LTS line; a new LTS is a deliberate move",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "allowedVersions": "/^10\\.11\\./"
    },
    {
      "description": "Langfuse's postgres stays on 17: a major needs a pg_upgrade + the 18+ volume layout (PR #64 rolled back on every deploy 2026-10-31..11-11)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "/^17\\./"
    },
    {
      "description": "Immich: server + ML + its postgres together, never a major without reading the notes",
      "matchPackageNames": [
        "ghcr.io/immich-app/**"
      ],
      "groupName": "immich"
    },
    {
      "description": "Digest-pinned helper images (valkey, Immich's postgres) and autoheal's moving :latest are left to their maintainers' cadence",
      "matchPackageNames": [
        "willfarrell/autoheal",
        "docker.io/valkey/valkey",
        "ghcr.io/immich-app/postgres"
      ],
      "enabled": false
    },
    {
      "description": "GitHub Actions: one weekly PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "duckdns uses git-sha tags (no order) -- left to DIUN",
      "matchPackageNames": [
        "lscr.io/linuxserver/duckdns"
      ],
      "enabled": false
    },
    {
      "description": "Auto-merge minor + patch updates once CI passes (Renovate never merges red or pending checks). Majors stay manual.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "0.x: a minor bump may break (semver), so it stays manual",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "Jellyfin DB migrations are one-way: every bump stays a reviewed PR",
      "matchPackageNames": [
        "jellyfin/jellyfin"
      ],
      "automerge": false
    }
  ],
  "automergeSchedule": [
    "after 7am and before 11pm"
  ]
}
