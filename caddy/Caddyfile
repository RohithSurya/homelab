# Global options + shared snippets only. Every vhost lives in its own file under
# sites.d/ — adding a service must never require editing this file.
#
# TLS: automatic Let's Encrypt. Port 80 is blocked by Comcast, so issuance
# happens over TLS-ALPN-01 on :443 (Caddy falls back to it automatically).

{
	email prsurya1020@gmail.com
}

# Shared hardening headers. Import into every site block.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Rolling JSON access log for a public vhost. Pass the log basename, e.g.
#   import access_log immich
# Caddy is the internet-facing edge, so "client_ip" here is the real client IP —
# which is what the fail2ban filters key their bans on.
(access_log) {
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json {
			time_format iso8601
		}
	}
}

# One file per exposed service. Path is relative to this Caddyfile (/etc/caddy).
import sites.d/*.caddy
