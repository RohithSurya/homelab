# Copy to .env and fill in your own values.
WIREGUARD_PRIVATE_KEY=
SEEDR_EMAIL=
SEEDR_PASSWORD_B64=
RADARR_API_KEY=
SONARR_API_KEY=
NTFY_TOPIC=
JELLYFIN_API_KEY=
# movierulz Torznab feed apikey (generate: openssl rand -hex 12); also entered in Prowlarr
MOVIERULZ_APIKEY=
# Base URL of the movierulz site to crawl (no trailing slash)
MOVIERULZ_BASE=
# tamilmv/tamilblasters Torznab feed apikey (generate: openssl rand -hex 12); also entered in Prowlarr.
# Domain seeds + forum maps come from GitHub (TAMILMV_CONFIG_URL, defaulted in compose) -- no site URL needed here.
TAMILMV_APIKEY=
# DaddyLive (DLHD) site base URL for the Jellyfin live-TV resolver (no trailing slash).
# Kept out of source like MOVIERULZ_BASE; update when the dlhd domain rotates.
DLHD_BASE=https://dlhd.st
# NOTE: DUCKDNS_TOKEN moved to ../exposer/.env along with the duckdns service.
   